# Optional: if set, backend will use this directly.
# Example:
# DATABASE_URL=postgresql+psycopg://postgres:postgres@database:5432/postgres

# If DATABASE_URL is NOT set, backend will attempt to build a URL using these (or defaults).
# POSTGRES_HOST=database
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=postgres
